generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  role          UserRole  @default(TRAVELER)
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  hotel              Hotel?
  hotelApplication   HotelApplication?
  hotelStaff         HotelStaff[]
  bookings           Booking[]
  reviews            Review[]
  serviceOrders      ServiceOrder[]
  refreshTokens      RefreshToken[]
}

enum UserRole {
  SUPER_ADMIN
  HOTEL_OWNER
  HOTEL_MANAGER
  HOTEL_STAFF
  TRAVELER
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Hotel {
  id                  String              @id @default(cuid())
  ownerId             String              @unique
  owner               User                @relation(fields: [ownerId], references: [id])
  name                String
  slug                String              @unique
  description         String?
  address             String
  city                String
  state               String
  country             String              @default("Nigeria")
  latitude            Float?
  longitude           Float?
  phone               String?
  email               String?
  checkInTime         String              @default("14:00")
  checkOutTime        String              @default("12:00")
  verificationStatus  VerificationStatus  @default(PENDING)
  isActive            Boolean             @default(false)
  isPublished         Boolean             @default(false)
  subscriptionPlan    SubscriptionPlan?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  staff               HotelStaff[]
  roomTypes           RoomType[]
  images              HotelImage[]
  documents           HotelDocument[]
  amenities           HotelAmenity[]
  reviews             Review[]
  verification        HotelVerification?
  subscription        Subscription?
  bookings            Booking[]
  apiKeys             ApiKey[]
  serviceVenues       ServiceVenue[]
  roomServiceEnabled  Boolean             @default(false)
  promotions          Promotion[]
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum SubscriptionPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model HotelApplication {
  id           String            @id @default(cuid())
  ownerId      String            @unique
  owner        User              @relation(fields: [ownerId], references: [id])
  status       ApplicationStatus @default(PENDING)
  adminNotes   String?

  name         String
  description  String?
  address      String
  city         String
  state        String
  country      String            @default("Nigeria")
  latitude     Float?
  longitude    Float?
  phone        String?
  email        String?
  checkInTime  String            @default("14:00")
  checkOutTime String            @default("12:00")

  amenityIds   String[]
  languages    String[]

  images       Json              @default("[]")
  documents    Json              @default("[]")
  rooms        Json              @default("[]")

  reviewedBy   String?
  reviewedAt   DateTime?

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model HotelDocument {
  id           String   @id @default(cuid())
  hotelId      String
  hotel        Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  documentType String
  label        String?
  url          String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([hotelId, documentType])
}

model HotelVerification {
  id          String             @id @default(cuid())
  hotelId     String             @unique
  hotel       Hotel              @relation(fields: [hotelId], references: [id])
  status      VerificationStatus @default(PENDING)
  notes       String?
  reviewedAt  DateTime?
  reviewedBy  String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model HotelStaff {
  id        String    @id @default(cuid())
  hotelId   String
  hotel     Hotel     @relation(fields: [hotelId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  role      StaffRole @default(STAFF)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@unique([hotelId, userId])
}

enum StaffRole {
  OWNER
  MANAGER
  RECEPTIONIST
  STAFF
}

model HotelImage {
  id        String   @id @default(cuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  url       String
  caption   String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Amenity {
  id     String         @id @default(cuid())
  name   String         @unique
  icon   String?
  hotels HotelAmenity[]
}

model HotelAmenity {
  hotelId   String
  hotel     Hotel   @relation(fields: [hotelId], references: [id])
  amenityId String
  amenity   Amenity @relation(fields: [amenityId], references: [id])

  @@id([hotelId, amenityId])
}

model RoomType {
  id               String         @id @default(cuid())
  hotelId          String
  hotel            Hotel          @relation(fields: [hotelId], references: [id])
  name             String
  description      String?
  bedType          String
  capacity         Int
  sizeSqm          Float?
  pricePerNight    Decimal        @db.Decimal(12, 2)
  totalRooms       Int
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  rooms            Room[]
  inventoryDays    InventoryDay[]
  bookings         Booking[]
}

model Room {
  id          String     @id @default(cuid())
  roomTypeId  String
  roomType    RoomType   @relation(fields: [roomTypeId], references: [id])
  number      String
  floor       Int?
  status      RoomStatus @default(AVAILABLE)
  notes       String?
  createdAt   DateTime   @default(now())

  @@unique([roomTypeId, number])
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  OUT_OF_ORDER
}

model InventoryDay {
  id            String   @id @default(cuid())
  roomTypeId    String
  roomType      RoomType @relation(fields: [roomTypeId], references: [id])
  date          DateTime @db.Date
  totalUnits    Int
  heldUnits     Int      @default(0)
  bookedUnits   Int      @default(0)
  priceOverride Decimal? @db.Decimal(12, 2)
  isBlocked     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([roomTypeId, date])
}

model Booking {
  id                 String        @id @default(cuid())
  reference          String        @unique
  userId             String
  user               User          @relation(fields: [userId], references: [id])
  hotelId            String
  hotel              Hotel         @relation(fields: [hotelId], references: [id])
  roomTypeId         String
  roomType           RoomType      @relation(fields: [roomTypeId], references: [id])
  checkIn            DateTime      @db.Date
  checkOut           DateTime      @db.Date
  nights             Int
  guests             Int
  guestFirstName     String
  guestLastName      String
  guestEmail         String
  guestPhone         String
  specialRequests    String?
  status             BookingStatus @default(PENDING)
  subtotalNgn        Decimal       @db.Decimal(12, 2)
  serviceFeeNgn      Decimal       @db.Decimal(12, 2)
  totalNgn           Decimal       @db.Decimal(12, 2)
  heldUntil          DateTime?
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  isWalkIn           Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  payment            Payment?
  review             Review?
  serviceOrders      ServiceOrder[]
  extensions         BookingExtension[]
}

model ApiKey {
  id          String    @id @default(cuid())
  hotelId     String
  hotel       Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name        String                        // e.g. "Opera PMS", "Custom integration"
  keyHash     String    @unique             // bcrypt hash of the raw key
  prefix      String                        // first 12 chars shown in UI e.g. "hos_live_abcd"
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum BookingStatus {
  PENDING
  HELD
  PAYMENT_PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
  FAILED
}

model Payment {
  id            String        @id @default(cuid())
  bookingId     String        @unique
  booking       Booking       @relation(fields: [bookingId], references: [id])
  reference     String        @unique
  amountNgn     Decimal       @db.Decimal(12, 2)
  commissionNgn Decimal       @db.Decimal(12, 2)
  netNgn        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  provider      String        @default("paystack")
  providerRef   String?
  method        String?
  paidAt        DateTime?
  failedAt      DateTime?
  failureReason String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  refund        Refund?
  payoutItem    PayoutItem?
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
}

model Refund {
  id          String       @id @default(cuid())
  paymentId   String       @unique
  payment     Payment      @relation(fields: [paymentId], references: [id])
  amountNgn   Decimal      @db.Decimal(12, 2)
  reason      String
  status      RefundStatus @default(PENDING)
  processedAt DateTime?
  createdAt   DateTime     @default(now())
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Subscription {
  id             String             @id @default(cuid())
  hotelId        String             @unique
  hotel          Hotel              @relation(fields: [hotelId], references: [id])
  plan           SubscriptionPlan
  status         SubscriptionStatus @default(ACTIVE)
  priceNgn       Decimal            @db.Decimal(12, 2)
  startDate      DateTime
  nextBilling    DateTime
  gracePeriodEnd DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

enum SubscriptionStatus {
  ACTIVE
  GRACE_PERIOD
  SUSPENDED
  ARCHIVED
}

model Payout {
  id          String       @id @default(cuid())
  hotelId     String
  amountNgn   Decimal      @db.Decimal(12, 2)
  status      PayoutStatus @default(PENDING)
  requestedAt DateTime     @default(now())
  processedAt DateTime?
  reference   String?
  bankAccount String?
  items       PayoutItem[]
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model PayoutItem {
  id        String  @id @default(cuid())
  payoutId  String
  payout    Payout  @relation(fields: [payoutId], references: [id])
  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId], references: [id])
  amountNgn Decimal @db.Decimal(12, 2)
}

model Review {
  id               String   @id @default(cuid())
  bookingId        String   @unique
  booking          Booking  @relation(fields: [bookingId], references: [id])
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  hotelId          String
  hotel            Hotel    @relation(fields: [hotelId], references: [id])
  overallRating    Int
  cleanlinessRating Int
  locationRating   Int
  serviceRating    Int
  valueRating      Int
  facilitiesRating Int
  title            String
  body             String
  isVerified       Boolean  @default(true)
  isApproved       Boolean  @default(false)
  isFlagged        Boolean  @default(false)
  hotelResponse    String?
  respondedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ─── Promotions ──────────────────────────────────────────────────────────────

model Promotion {
  id                  String        @id @default(cuid())
  hotelId             String
  hotel               Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name                String
  discountType        DiscountType
  discountValue       Decimal       @db.Decimal(10, 2)
  validFrom           DateTime      @db.Date
  validTo             DateTime      @db.Date
  minNights           Int           @default(1)
  advanceBookingDays  Int           @default(0)
  active              Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// ─── Stay Extension ──────────────────────────────────────────────────────────

model BookingExtension {
  id               String   @id @default(cuid())
  bookingId        String
  booking          Booking  @relation(fields: [bookingId], references: [id])
  /// Check-out date before this extension
  prevCheckOut     DateTime @db.Date
  /// Check-out date after this extension
  newCheckOut      DateTime @db.Date
  extraNights      Int
  extraAmountNgn   Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
}

// ─── Room Service ────────────────────────────────────────────────────────────

model ServiceVenue {
  id          String             @id @default(cuid())
  hotelId     String
  hotel       Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name        String             // e.g. "The Rooftop Restaurant", "Pool Bar"
  type        ServiceVenueType
  description String?
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  menuItems   ServiceMenuItem[]
  orders      ServiceOrder[]
}

enum ServiceVenueType {
  RESTAURANT
  BAR
  CAFE
  ROOM_SERVICE
  OTHER
}

model ServiceMenuItem {
  id          String       @id @default(cuid())
  venueId     String
  venue       ServiceVenue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name        String
  description String?
  category    String       // e.g. "Starters", "Mains", "Drinks"
  priceNgn    Decimal      @db.Decimal(12, 2)
  isAvailable Boolean      @default(true)
  imageUrl    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  orderItems  ServiceOrderItem[]
}

model ServiceOrder {
  id          String             @id @default(cuid())
  reference   String             @unique
  bookingId   String
  booking     Booking            @relation(fields: [bookingId], references: [id])
  venueId     String
  venue       ServiceVenue       @relation(fields: [venueId], references: [id])
  userId      String
  user        User               @relation(fields: [userId], references: [id])
  status      ServiceOrderStatus @default(PENDING)
  totalNgn    Decimal            @db.Decimal(12, 2)
  notes       String?            // special requests / delivery notes
  roomNumber  String?
  payment     ServicePayment?
  items       ServiceOrderItem[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

enum ServiceOrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  DELIVERED
  CANCELLED
}

model ServiceOrderItem {
  id         String          @id @default(cuid())
  orderId    String
  order      ServiceOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   ServiceMenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int
  unitPrice  Decimal         @db.Decimal(12, 2)
  lineTotal  Decimal         @db.Decimal(12, 2)
}

model ServicePayment {
  id          String               @id @default(cuid())
  orderId     String               @unique
  order       ServiceOrder         @relation(fields: [orderId], references: [id])
  reference   String               @unique
  amountNgn   Decimal              @db.Decimal(12, 2)
  status      ServicePaymentStatus @default(PENDING)
  provider    String               @default("paystack")
  providerRef String?
  paidAt      DateTime?
  failedAt    DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

enum ServicePaymentStatus {
  PENDING
  SUCCESS
  FAILED
}
